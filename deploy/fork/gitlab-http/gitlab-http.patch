+// HTTPGitLabProject is the external MR project key for a private HTTP clone URL.
+func HTTPGitLabProject(remote string) string {
+	u, err := neturl.Parse(remote)
+	if err != nil || u.Scheme != "http" || u.User != nil || u.RawPath != "" {
+		return ""
+	}
+	scope, err := gitwork.HTTPHostScope(gitwork.PlainHTTPPrefix + u.Host)
+	if err != nil {
+		return ""
+	}
+	path := strings.TrimSuffix(strings.Trim(u.Path, "/"), ".git")
+	project := MRProjectHTTPGitLab + strings.TrimPrefix(scope, gitwork.PlainHTTPPrefix) + "/" + path
+	if _, _, _, ok := ExternalMRProject(project); !ok {
+		return ""
+	}
+	return project
+}
